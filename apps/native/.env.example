# Copy to .env.local and fill from `yarn supabase status`.
#
# EXPO_PUBLIC_* is inlined into the shipped JS bundle. Never put the
# service_role / sb_secret_* key here — it has BYPASSRLS.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Where apps/web is reachable FROM THE DEVICE.
# - iOS simulator:  http://localhost:3000
# - Android emu:    http://10.0.2.2:3000
# - Physical device: your machine's LAN IP, e.g. http://192.168.1.20:3000
# Leave unset in dev to infer the LAN IP from the Expo dev server host.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
